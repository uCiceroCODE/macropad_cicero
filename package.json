{
  "name": "tastierino-macropad",
  "version": "1.0.0",
  "description": "Desktop app per la gestione del tastierino custom con Electron e React",
  "main": "src/main/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:react\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:react": "vite build",
    "build:tools": "scripts\\build-tools.bat",
    "build": "npm run build:react",
    "start": "cross-env NODE_ENV=production electron ."
  },
  "keywords": [
    "macropad",
    "electron",
    "react",
    "arduino",
    "serialport",
    "hid"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "native-sound-mixer": "^3.4.6-win",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
